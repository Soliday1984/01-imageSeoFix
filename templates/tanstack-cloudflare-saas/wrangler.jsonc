  //     "binding": "DB",
  //     "database_name": "edge-saas-starter",
  //     "database_id": "replace-with-d1-database-id"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "FILES",
  //     "bucket_name": "edge-saas-starter-files"
  //   }
  // ],
  // "kv_namespaces": [
  //   {
  //     "binding": "CACHE",
  //     "id": "replace-with-kv-namespace-id"
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // }
}
